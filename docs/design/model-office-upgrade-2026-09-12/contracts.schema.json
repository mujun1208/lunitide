{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/prd/model-office-upgrade/1/schema.json",
  "title": "Lunitide model-office upgrade normative contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/ModelProfile"
    },
    {
      "$ref": "#/$defs/TaskOutcome"
    },
    {
      "$ref": "#/$defs/DeliveryPolicy"
    },
    {
      "$ref": "#/$defs/FormalDecision"
    },
    {
      "$ref": "#/$defs/EvalSuite"
    },
    {
      "$ref": "#/$defs/Traceability"
    }
  ],
  "$defs": {
    "ModelProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 2
        },
        "profileId": {
          "type": "string",
          "minLength": 1
        },
        "family": {
          "type": "string",
          "enum": [
            "deepseek",
            "glm",
            "generic"
          ]
        },
        "codecVersion": {
          "type": "string",
          "minLength": 1
        },
        "modelContract": {
          "type": "string",
          "minLength": 1
        },
        "endpointPurpose": {
          "type": "string",
          "enum": [
            "standard",
            "coding_plan",
            "proxy",
            "local"
          ]
        },
        "protocol": {
          "type": "string",
          "enum": [
            "openai_compatible",
            "anthropic"
          ]
        },
        "modelIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "modes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "quick": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "thinkingType": {
                  "type": "string",
                  "enum": [
                    "enabled",
                    "disabled",
                    "omitted"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "omitted",
                    "low",
                    "high",
                    "max"
                  ]
                },
                "clearThinking": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "thinkingType",
                "effort",
                "clearThinking"
              ]
            },
            "standard": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "thinkingType": {
                  "type": "string",
                  "enum": [
                    "enabled",
                    "disabled",
                    "omitted"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "omitted",
                    "low",
                    "high",
                    "max"
                  ]
                },
                "clearThinking": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "thinkingType",
                "effort",
                "clearThinking"
              ]
            },
            "deep": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "thinkingType": {
                  "type": "string",
                  "enum": [
                    "enabled",
                    "disabled",
                    "omitted"
                  ]
                },
                "effort": {
                  "type": "string",
                  "enum": [
                    "omitted",
                    "low",
                    "high",
                    "max"
                  ]
                },
                "clearThinking": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "thinkingType",
                "effort",
                "clearThinking"
              ]
            }
          },
          "required": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "replayPolicy": {
          "type": "string",
          "enum": [
            "exact_assistant_history",
            "tool_groups",
            "none"
          ]
        },
        "strictTools": {
          "type": "boolean"
        },
        "strictEndpointSuffix": {
          "type": "string"
        },
        "contextWindow": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "sourceUrls": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "format": "uri"
          },
          "minItems": 1
        },
        "sourceCheckedAt": {
          "type": "string",
          "minLength": 1,
          "format": "date"
        }
      },
      "required": [
        "schemaVersion",
        "profileId",
        "family",
        "codecVersion",
        "modelContract",
        "endpointPurpose",
        "protocol",
        "modelIds",
        "modes",
        "replayPolicy",
        "strictTools",
        "strictEndpointSuffix",
        "contextWindow",
        "maxOutputTokens",
        "sourceUrls",
        "sourceCheckedAt"
      ]
    },
    "TaskOutcome": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "taskId": {
          "type": "string",
          "minLength": 1
        },
        "goalRevision": {
          "type": "integer",
          "minimum": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "type": "string",
          "enum": [
            "succeeded",
            "incomplete",
            "paused",
            "failed",
            "cancelled",
            "outcome_unknown"
          ]
        },
        "completion": {
          "type": "string",
          "enum": [
            "verified",
            "not_required",
            "unverified"
          ]
        },
        "reasonCode": {
          "type": "string"
        },
        "requiredSteps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "passedSteps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "remainingSteps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "taskId",
        "goalRevision",
        "version",
        "state",
        "completion",
        "reasonCode",
        "requiredSteps",
        "passedSteps",
        "remainingSteps",
        "evidenceRefs",
        "artifactRefs"
      ]
    },
    "DeliveryPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "targetRenderer": {
          "type": "string",
          "minLength": 1
        },
        "requiredCheckIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "requireEditable": {
          "type": "boolean"
        },
        "requireSearchable": {
          "type": "boolean"
        },
        "requireVisualReview": {
          "type": "boolean"
        }
      },
      "required": [
        "revision",
        "targetRenderer",
        "requiredCheckIds",
        "requireEditable",
        "requireSearchable",
        "requireVisualReview"
      ]
    },
    "FormalDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisionId": {
          "type": "string",
          "minLength": 1
        },
        "versionId": {
          "type": "string",
          "minLength": 1
        },
        "sourceSha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}$"
        },
        "policyRevision": {
          "type": "string",
          "minLength": 1
        },
        "allowed": {
          "type": "boolean"
        },
        "state": {
          "type": "string",
          "enum": [
            "draft",
            "checking",
            "needs_review",
            "verified",
            "blocked"
          ]
        },
        "blockingCodes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "missingChecks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        }
      },
      "required": [
        "decisionId",
        "versionId",
        "sourceSha256",
        "policyRevision",
        "allowed",
        "state",
        "blockingCodes",
        "missingChecks",
        "evidenceRefs"
      ]
    },
    "Budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTotalTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 0
        },
        "maxModelAttempts": {
          "type": "integer",
          "minimum": 0
        },
        "maxActiveMillis": {
          "type": "integer",
          "minimum": 0
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0
        },
        "closeoutOutputTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "maxTotalTokens",
        "maxOutputTokens",
        "maxModelAttempts",
        "maxActiveMillis",
        "maxOutputBytes",
        "closeoutOutputTokens"
      ]
    },
    "EvalCase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[DPXFRLC][0-9]{2}$"
        },
        "version": {
          "const": 1
        },
        "category": {
          "type": "string",
          "enum": [
            "office",
            "protocol",
            "long_task",
            "code_data"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "docx",
            "pptx",
            "xlsx",
            "pdf",
            "none",
            "bundle"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "inputBuilder": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "expectedTaskSuccess": {
          "type": "boolean"
        },
        "expectedStates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskState"
          },
          "minItems": 1
        },
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "oracle": {
          "type": "string",
          "minLength": 1
        },
        "fixtureOnly": {
          "type": "boolean"
        },
        "sourceRequirementIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^FR[0-9]{2}$"
          },
          "minItems": 1
        },
        "scenarios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvalScenario"
          },
          "minItems": 1
        }
      },
      "required": [
        "caseId",
        "version",
        "category",
        "format",
        "title",
        "prompt",
        "inputBuilder",
        "inputs",
        "checks",
        "expectedTaskSuccess",
        "expectedStates",
        "budget",
        "oracle",
        "fixtureOnly",
        "sourceRequirementIds",
        "scenarios"
      ]
    },
    "TaskState": {
      "type": "string",
      "enum": [
        "succeeded",
        "incomplete",
        "paused",
        "failed",
        "cancelled",
        "outcome_unknown"
      ]
    },
    "EvalSuite": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "suiteId": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "cases": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EvalCase"
          },
          "minItems": 24,
          "maxItems": 24
        }
      },
      "required": [
        "schemaVersion",
        "suiteId",
        "version",
        "scope",
        "rules",
        "cases"
      ]
    },
    "Traceability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "baselineCommit": {
          "type": "string",
          "minLength": 1
        },
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "pattern": "^FR[0-9]{2}$"
              },
              "requirement": {
                "type": "string",
                "minLength": 1
              },
              "perspectives": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "user",
                    "code",
                    "audit"
                  ]
                },
                "minItems": 3
              },
              "tasks": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^T[0-9]{2}$"
                },
                "minItems": 1
              },
              "testIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              },
              "evidenceKinds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "requirement",
              "perspectives",
              "tasks",
              "testIds",
              "evidenceKinds"
            ]
          },
          "minItems": 30,
          "maxItems": 30
        }
      },
      "required": [
        "schemaVersion",
        "baselineCommit",
        "requirements"
      ]
    },
    "EvalScenario": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scenarioId": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "type": "string",
          "enum": [
            "fixture",
            "live"
          ]
        },
        "statisticGroup": {
          "type": "string",
          "enum": [
            "office_delivery",
            "protocol_live",
            "long_task_live",
            "code_data_live",
            "contract_fault"
          ]
        },
        "inputOverrides": {
          "type": "object"
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "expectedTaskSuccess": {
          "type": "boolean"
        },
        "expectedStates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TaskState"
          },
          "minItems": 1
        }
      },
      "required": [
        "scenarioId",
        "mode",
        "statisticGroup",
        "inputOverrides",
        "checks",
        "expectedTaskSuccess",
        "expectedStates"
      ]
    }
  }
}
