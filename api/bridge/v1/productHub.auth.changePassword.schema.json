{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/productHub.auth.changePassword.schema.json",
  "title": "productHub.auth.changePassword payload",
  "x-method": "productHub.auth.changePassword",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionToken": { "type": "string", "minLength": 1, "maxLength": 128 },
    "currentPassword": { "type": "string", "minLength": 1, "maxLength": 128 },
    "newPassword": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "required": ["sessionToken", "currentPassword", "newPassword"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ok": { "type": "boolean" }
    },
    "required": ["ok"]
  },
  "x-examples": {
    "positive": [{ "sessionToken": "ab", "currentPassword": "old", "newPassword": "new" }],
    "negative": [{ "sessionToken": "", "currentPassword": "old", "newPassword": "new" }]
  }
}
