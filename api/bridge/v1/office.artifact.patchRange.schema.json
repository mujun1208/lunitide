{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/office.artifact.patchRange.schema.json",
  "title": "office.artifact.patchRange payload",
  "x-method": "office.artifact.patchRange",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "artifactId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "baseVersionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ranges": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "part": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "range": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "expectedDigest": {
            "type": "string",
            "minLength": 64,
            "maxLength": 64
          },
          "rows": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "type": "array",
              "maxItems": 128,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "text",
                      "number",
                      "boolean",
                      "formula",
                      "date",
                      "blank"
                    ]
                  },
                  "value": {
                    "type": "string",
                    "minLength": 0,
                    "maxLength": 32768
                  }
                },
                "required": [
                  "type"
                ]
              }
            }
          }
        },
        "required": [
          "part",
          "range",
          "expectedDigest",
          "rows"
        ]
      }
    }
  },
  "required": [
    "taskId",
    "artifactId",
    "baseVersionId",
    "expectedRevision",
    "ranges"
  ],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/OfficeTaskDetailDTO"
  },
  "x-examples": {
    "positive": [
      {
        "taskId": "01ARZ3NDEKTSV4RRFFQ69G5FAE",
        "artifactId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "baseVersionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedRevision": 1,
        "ranges": [
          {
            "part": "xl/worksheets/sheet1.xml",
            "range": "A1:A1",
            "expectedDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
            "rows": [
              [
                {
                  "type": "text",
                  "value": "0012"
                }
              ]
            ]
          }
        ]
      }
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  }
}
