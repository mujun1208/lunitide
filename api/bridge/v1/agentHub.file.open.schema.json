{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/agentHub.file.open.schema.json",
  "title": "agentHub.file.open payload",
  "x-method": "agentHub.file.open",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "path": { "type": "string", "maxLength": 1024 },
    "reveal": { "type": "boolean" }
  },
  "required": ["taskId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "opened": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "required": ["opened"]
  },
  "x-examples": {
    "positive": [{ "taskId": "01ARZ3NDEKTSV4RRFFQ69G5FAE", "path": "hello.txt" }],
    "negative": [{}]
  }
}
