{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/ocr.routing.get.schema.json",
  "title": "ocr.routing.get payload",
  "x-method": "ocr.routing.get",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["scopeKind"],
  "properties": {
    "scopeKind": { "type": "string", "enum": ["user", "project"] },
    "scopeId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "refreshProbe": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "properties": { "scopeKind": { "const": "user" } } },
      "then": { "properties": { "scopeId": false } }
    },
    {
      "if": { "properties": { "scopeKind": { "const": "project" } } },
      "then": { "required": ["scopeId"], "properties": { "scopeId": {} } }
    }
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["requestedScope", "policySource", "policy", "revision", "windowsProbe", "legacy"],
    "properties": {
      "requestedScope": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeKind", "scopeId"],
        "properties": {
          "scopeKind": { "enum": ["user", "project"] },
          "scopeId": { "type": ["string", "null"] }
        }
      },
      "policySource": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeKind", "scopeId", "inherited"],
        "properties": {
          "scopeKind": { "enum": ["user", "project"] },
          "scopeId": { "type": ["string", "null"] },
          "inherited": { "type": "boolean" }
        }
      },
      "policy": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "complexDocumentEngine", "fallbackOrder", "sendToCloud"],
        "properties": {
          "mode": { "enum": ["auto", "local_fast", "local_document", "provider_first"] },
          "complexDocumentEngine": { "enum": ["none", "paddleocr-vl-1.6"] },
          "fallbackOrder": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "enum": ["windows-ocr", "paddleocr-vl-1.6", "provider", "ppocr"] }
          },
          "sendToCloud": { "enum": ["never", "configured_only"] },
          "providerId": {
            "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
          },
          "modelId": { "type": "string", "minLength": 1, "maxLength": 200 }
        }
      },
      "revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "windowsProbe": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "available", "languages", "checkedAt"],
        "properties": {
          "state": { "enum": ["ready", "unsupported_os", "initialization_failed", "language_unavailable", "sample_failed", "timed_out"] },
          "available": { "type": "boolean" },
          "languages": {
            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 64 }
          },
          "checkedAt": { "type": "string", "format": "date-time" }
        }
      },
      "legacy": {
        "oneOf": [
          { "type": "null" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["engineId", "registered", "state", "available", "markerDetected"],
            "properties": {
              "engineId": { "const": "ppocr" },
              "registered": { "const": true },
              "state": { "const": "registered_unwired" },
              "available": { "const": false },
              "markerDetected": { "type": "boolean" }
            }
          }
        ]
      }
    }
  },
  "x-examples": {
    "positive": [
      { "scopeKind": "user" },
      { "scopeKind": "user", "refreshProbe": true },
      { "scopeKind": "project", "scopeId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" }
    ],
    "negative": [
      {},
      { "scopeKind": "user", "scopeId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" },
      { "scopeKind": "project" },
      { "unexpected": true }
    ]
  }
}
