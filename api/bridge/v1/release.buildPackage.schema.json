{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/release.buildPackage.schema.json",
  "title": "release.buildPackage payload",
  "x-method": "release.buildPackage",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "crRevisionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "expectedDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "crRevisionId",
    "expectedDigest"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "packageId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "manifestDigest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "blobDigest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "required": [
      "packageId",
      "manifestDigest",
      "blobDigest"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "crRevisionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedDigest": "d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4d4"
      }
    ],
    "negative": [
      {
        "crRevisionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedDigest": "not-a-digest"
      }
    ]
  }
}