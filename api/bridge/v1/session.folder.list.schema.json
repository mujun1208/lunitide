{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/session.folder.list.schema.json",
  "title": "session.folder.list payload",
  "x-method": "session.folder.list",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "relativePath": { "type": "string", "maxLength": 512 }
  },
  "required": ["sessionId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "path": { "type": "string" },
            "directory": { "type": "boolean" }
          },
          "required": ["name", "path", "directory"]
        }
      }
    },
    "required": ["items"]
  },
  "x-examples": {
    "positive": [{ "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" }],
    "negative": [{ "sessionId": "bad" }]
  }
}
