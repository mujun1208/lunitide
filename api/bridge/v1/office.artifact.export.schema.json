{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/office.artifact.export.schema.json",
  "title": "office.artifact.export payload",
  "x-method": "office.artifact.export",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "versionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "name": {
      "type": "string",
      "minLength": 0,
      "maxLength": 240
    },
    "draft": {
      "type": "boolean"
    }
  },
  "required": [
    "taskId",
    "versionId",
    "draft"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096
      },
      "absolutePath": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096
      },
      "notice": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096
      }
    },
    "required": [
      "path"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "taskId": "01ARZ3NDEKTSV4RRFFQ69G5FAE",
        "versionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "draft": true
      }
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  }
}
