{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/remote.pair.code.schema.json",
  "title": "remote.pair.code payload",
  "x-method": "remote.pair.code",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[0-9]{8}$",
        "description": "一次性 8 位配对码，5 分钟有效。"
      },
      "url": {
        "type": "string",
        "pattern": "^https://",
        "description": "二维码内容：地址 + 配对码 + 证书指纹（片段）。"
      },
      "expiresAt": {
        "type": "string",
        "format": "date-time"
      },
      "qrPngBase64": {
        "type": "string",
        "minLength": 64,
        "description": "512px 二维码 PNG 的 base64，桌面端直接渲染。"
      },
      "addresses": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "fingerprint": {
        "type": "string",
        "pattern": "^[0-9a-f]{16}$"
      }
    },
    "required": [
      "code",
      "url",
      "expiresAt",
      "qrPngBase64",
      "addresses",
      "fingerprint"
    ]
  },
  "x-examples": {
    "positive": [
      {}
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  }
}
