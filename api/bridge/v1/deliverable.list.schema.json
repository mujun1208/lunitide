{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/deliverable.list.schema.json",
  "title": "deliverable.list payload",
  "x-method": "deliverable.list",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "phase": { "type": "integer", "minimum": 1, "maximum": 9 },
    "status": { "enum": ["draft", "review", "approved", "immutable"] }
  },
  "required": ["projectId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
            "projectId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
            "phase": { "type": "integer", "minimum": 1, "maximum": 9 },
            "documentType": { "type": "string" },
            "title": { "type": "string" },
            "templateId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
            "attachmentId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
            "status": { "enum": ["draft", "review", "approved", "immutable"] },
            "gateConfirmations": { "type": "integer", "minimum": 0, "maximum": 3 },
            "digest": { "type": "string" },
            "createdAt": { "type": "string", "format": "date-time" },
            "updatedAt": { "type": "string", "format": "date-time" },
            "version": { "type": "integer", "minimum": 1 }
          },
          "required": ["id", "projectId", "phase", "documentType", "title", "status", "gateConfirmations", "createdAt", "updatedAt", "version"]
        }
      }
    },
    "required": ["items"]
  },
  "x-examples": {
    "positive": [{ "projectId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "phase": 1 }],
    "negative": [{ "projectId": "bad" }]
  }
}
