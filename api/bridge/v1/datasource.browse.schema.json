{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/datasource.browse.schema.json",
  "title": "datasource.browse payload",
  "x-method": "datasource.browse",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "scope": { "type": "string", "enum": ["catalog", "schema", "table", "column"] },
    "schema": { "type": "string", "maxLength": 128 },
    "table": { "type": "string", "maxLength": 128 }
  },
  "required": ["id", "scope"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 128 },
            "schema": { "type": "string", "maxLength": 128 }
          },
          "required": ["name"]
        }
      }
    },
    "required": ["items"]
  },
  "x-examples": {
    "positive": [
      {
        "id": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "scope": "schema"
      }
    ],
    "negative": [
      {
        "id": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "scope": "rows"
      }
    ]
  }
}
