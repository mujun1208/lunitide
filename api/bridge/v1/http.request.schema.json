{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/http.request.schema.json",
  "title": "http.request payload",
  "x-method": "http.request",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "method": {
      "type": "string",
      "enum": ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"]
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "body": {
      "type": "string"
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60000
    },
    "maxResponseBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10485760
    },
    "reviewed": {
      "type": "boolean"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": ["runId", "method", "url", "timeoutMs", "maxResponseBytes"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status": {
        "type": "integer"
      },
      "body": {
        "type": "string"
      },
      "bodyDigest": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "bytes": {
        "type": "integer",
        "minimum": 0
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": ["status", "bodyDigest", "bytes", "truncated"]
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "method": "GET",
        "url": "https://example.com/api/v1/status",
        "timeoutMs": 10000,
        "maxResponseBytes": 1048576
      }
    ],
    "negative": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "method": "TRACE",
        "url": "https://example.com/api",
        "timeoutMs": 10,
        "maxResponseBytes": 1024
      }
    ]
  }
}
