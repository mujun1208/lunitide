{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/fs.grep.schema.json",
  "title": "fs.grep payload",
  "x-method": "fs.grep",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "leaseId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "fencingToken": {
      "type": "integer",
      "minimum": 1
    },
    "pattern": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    }
  },
  "required": ["leaseId", "fencingToken", "pattern"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/FsGrepResultDTO"
  },
  "x-examples": {
    "positive": [
      {
        "leaseId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "fencingToken": 1,
        "pattern": "func main",
        "path": "src",
        "maxResults": 100
      }
    ],
    "negative": [
      {
        "leaseId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "fencingToken": 1
      }
    ]
  }
}
