{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/error.schema.json",
  "title": "Lunitide Bridge v1 error",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "message",
    "retryable",
    "correlationId"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "retryable": {
      "type": "boolean"
    },
    "details": {
      "type": "object"
    },
    "correlationId": {
      "type": "string",
      "minLength": 26,
      "maxLength": 26
    }
  },
  "x-examples": {
    "positive": [
      {
        "code": "BAD_REQUEST",
        "message": "bad",
        "retryable": false,
        "correlationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ],
    "negative": [
      {
        "code": "bad",
        "message": "",
        "retryable": false,
        "correlationId": "x"
      }
    ]
  }
}