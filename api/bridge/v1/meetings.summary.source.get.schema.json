{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/meetings.summary.source.get.schema.json",
  "title": "meetings.summary.source.get payload",
  "x-method": "meetings.summary.source.get",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "meetingId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "offset": { "type": "integer", "minimum": 0, "maximum": 1048576 }
  },
  "required": ["meetingId", "sourceDigest", "offset"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "meetingId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "sourceRevision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
      "sourceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "title": { "type": "string", "maxLength": 200 },
      "transcript": { "type": "string", "maxLength": 16384 },
      "offset": { "type": "integer", "minimum": 0, "maximum": 1048576 },
      "nextOffset": { "type": "integer", "minimum": 0, "maximum": 1048576 },
      "totalRunes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
    },
    "required": ["meetingId", "sourceRevision", "sourceDigest", "title", "transcript", "offset", "nextOffset", "totalRunes"]
  },
  "x-examples": {
    "positive": [{ "meetingId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "sourceDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "offset": 0 }],
    "negative": [{}, { "meetingId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "sourceDigest": "bad", "offset": -1 }]
  }
}
