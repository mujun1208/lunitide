{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/session.metadata.set.schema.json",
  "title": "session.metadata.set payload",
  "x-method": "session.metadata.set",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "mroContext": {
      "$ref": "https://lunitide.local/schema/bridge/v1/session.metadata.set.schema.json#/$defs/MroContext"
    }
  },
  "required": ["sessionId", "mroContext"],
  "$defs": {
    "MroContext": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tailNo": { "type": "string", "minLength": 1, "maxLength": 32 },
        "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "manualIds": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
          }
        },
        "pack": { "type": "string", "const": "mro.v1" },
        "scenario": { "type": "string", "enum": ["manual", "fault", "checklist"] }
      },
      "required": ["tailNo", "asOf", "pack"]
    }
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "mroContext": {
        "$ref": "https://lunitide.local/schema/bridge/v1/session.metadata.set.schema.json#/$defs/MroContext"
      }
    },
    "required": ["mroContext"]
  },
  "x-examples": {
    "positive": [
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "mroContext": {
          "tailNo": "B-0000",
          "asOf": "2026-09-03",
          "pack": "mro.v1"
        }
      }
    ],
    "negative": [
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "mroContext": {
          "tailNo": "B-0000",
          "pack": "mro.v1"
        }
      }
    ]
  }
}
