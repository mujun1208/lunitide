{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/memory.settings.update.schema.json",
  "title": "memory.settings.update payload",
  "x-method": "memory.settings.update",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "memoryEnabled": {
      "type": "boolean"
    },
    "autoNominate": {
      "type": "boolean"
    },
    "growthDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "expectedVersion": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "subjectId",
    "memoryEnabled",
    "autoNominate",
    "growthDays",
    "expectedVersion"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "subjectId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "memoryEnabled": {
        "type": "boolean"
      },
      "autoNominate": {
        "type": "boolean"
      },
      "growthDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 90
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      },
      "version": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "required": [
      "subjectId",
      "memoryEnabled",
      "autoNominate",
      "growthDays",
      "updatedAt",
      "version"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "subjectId": "user-1",
        "memoryEnabled": true,
        "autoNominate": false,
        "growthDays": 14,
        "expectedVersion": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      }
    ],
    "negative": [
      {
        "subjectId": "user-1",
        "memoryEnabled": true,
        "autoNominate": false,
        "growthDays": 0,
        "expectedVersion": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      {
        "subjectId": "user-1",
        "memoryEnabled": true,
        "autoNominate": false,
        "growthDays": 91,
        "expectedVersion": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      {
        "subjectId": "user-1",
        "memoryEnabled": true,
        "growthDays": 14,
        "expectedVersion": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      {
        "subjectId": "local-user",
        "memoryEnabled": true,
        "autoNominate": false,
        "growthDays": 14
      }
    ]
  }
}
