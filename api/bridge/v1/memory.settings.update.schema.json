{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/memory.settings.update.schema.json",
  "title": "memory.settings.update payload",
  "x-method": "memory.settings.update",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "subjectId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "memoryEnabled": {
      "type": "boolean"
    },
    "autoNominate": {
      "type": "boolean"
    },
    "growthDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    },
    "expectedVersion": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "captureMode": {
      "type": "string",
      "enum": ["auto", "manual", "off"]
    },
    "personalMemoryEnabled": {
      "type": "boolean"
    },
    "projectMemoryEnabled": {
      "type": "boolean"
    },
    "expectedRevision": {
      "type": "integer",
      "minimum": 1
    }
  },
  "oneOf": [
    {
      "required": ["subjectId", "memoryEnabled", "autoNominate", "growthDays", "expectedVersion"],
      "properties": {
        "subjectId": {},
        "memoryEnabled": {},
        "autoNominate": {},
        "growthDays": {},
        "expectedVersion": {},
        "captureMode": {},
        "personalMemoryEnabled": false,
        "projectMemoryEnabled": false,
        "expectedRevision": false
      }
    },
    {
      "required": ["captureMode", "personalMemoryEnabled", "projectMemoryEnabled", "expectedRevision"],
      "properties": {
        "captureMode": {},
        "personalMemoryEnabled": {},
        "projectMemoryEnabled": {},
