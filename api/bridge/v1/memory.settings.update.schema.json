        "subjectId": false,
        "memoryEnabled": false,
        "autoNominate": false,
        "growthDays": false,
        "expectedVersion": false
      }
    }
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "subjectId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128
      },
      "memoryEnabled": {
        "type": "boolean"
      },
      "autoNominate": {
        "type": "boolean"
      },
      "growthDays": {
        "type": "integer",
        "minimum": 1,
        "maximum": 90
      },
      "updatedAt": {
        "type": "string",
        "format": "date-time"
      },
      "version": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "captureMode": {
        "type": "string",
        "enum": ["auto", "manual", "off"]
      },
      "revision": {
        "type": "integer",
        "minimum": 1
      },
      "personalMemoryEnabled": {
        "type": "boolean"
      },
      "projectMemoryEnabled": {
        "type": "boolean"
      }
    },
    "required": [
      "subjectId",
      "memoryEnabled",
      "autoNominate",
      "growthDays",
      "updatedAt",
      "version",
      "captureMode",
      "revision",
      "personalMemoryEnabled",
      "projectMemoryEnabled"
    ]
  },
  "x-examples": {
