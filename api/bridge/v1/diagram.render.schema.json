{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/diagram.render.schema.json",
  "title": "diagram.render payload", "x-method": "diagram.render", "x-owner": "host", "x-enabled": true,
  "type": "object", "additionalProperties": false,
  "properties": { "source": { "type": "string", "minLength": 1, "maxLength": 32768 }, "config": { "type": "object", "maxProperties": 64 } },
  "required": ["source", "config"],
  "x-result": { "type": "object", "additionalProperties": false, "properties": { "svg": { "type": "string", "minLength": 1, "maxLength": 1000000 }, "error": { "type": "string" } }, "required": ["svg"] },
  "x-examples": { "positive": [{ "source": "flowchart LR\nA-->B", "config": {} }], "negative": [{}, { "source": "", "config": {} }, { "source": "A", "config": {}, "url": "https://example.com" }] }
}
