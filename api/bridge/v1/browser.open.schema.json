{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/browser.open.schema.json",
  "title": "browser.open payload",
  "x-method": "browser.open",
  "x-owner": "host",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://"
    }
  },
  "required": ["url"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status": { "const": "opening" },
      "url": { "type": "string" }
    },
    "required": ["status", "url"]
  },
  "x-examples": {
    "positive": [{ "url": "https://example.com/" }],
    "negative": [
      {},
      { "url": "http://example.com/" },
      { "url": "https://example.com/", "extra": true }
    ]
  }
}
