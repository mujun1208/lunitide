{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/activity.list.schema.json",
  "title": "activity.list payload",
  "x-method": "activity.list",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["scopeKind"],
  "properties": {
    "scopeKind": { "type": "string", "enum": ["user", "project"] },
    "scopeId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["tool", "ocr", "media"] }
    },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 100 }
  },
  "allOf": [
    { "if": { "properties": { "scopeKind": { "const": "user" } } }, "then": { "properties": { "scopeId": false } } },
    { "if": { "properties": { "scopeKind": { "const": "project" } } }, "then": { "required": ["scopeId"], "properties": { "scopeId": {} } } }
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items", "nextCursor", "snapshotAt", "hasMore"],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 100,
        "items": { "$ref": "https://lunitide.local/schema/bridge/v1/media.dto.schema.json#/$defs/ActivitySnapshotDTO" }
      },
      "nextCursor": { "type": ["string", "null"], "minLength": 1, "maxLength": 512 },
      "snapshotAt": { "type": "string", "format": "date-time" },
      "hasMore": { "type": "boolean" }
    }
  },
  "x-examples": {
    "positive": [
      { "scopeKind": "user" },
      { "scopeKind": "user", "domains": ["media", "ocr"], "limit": 20 },
      { "scopeKind": "project", "scopeId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" }
    ],
    "negative": [
      {},
      { "scopeKind": "user", "scopeId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" },
      { "scopeKind": "project" },
      { "scopeKind": "user", "domains": [] },
      { "scopeKind": "user", "domains": ["media", "unknown"] }
    ]
  }
}
