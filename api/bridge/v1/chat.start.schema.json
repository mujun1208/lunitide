{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/chat.start.schema.json",
  "title": "chat.start payload",
  "x-method": "chat.start",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "providerId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sessionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "executionMode": {
      "enum": ["approval", "auto-edit", "plan", "full-access"]
    },
    "companion": {
      "type": "boolean",
      "description": "Moon Companion (月伴) voice request; engine upgrades executionMode to full-access and applies the spoken-style system instruction."
    },
    "replyStyle": {
      "enum": ["default", "assistant", "support", "teacher", "npc"],
      "description": "Optional speaking overlay. Does not replace 月汐 identity. Ignored when companion=true."
    },
    "structuredTemplate": {
      "enum": ["off", "event", "form", "kv"],
      "description": "Force the model to deliver via structured.output (event=calendar, form=labeled fields, kv=pairs). Ignored when companion=true or off."
    },
    "projectPhase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "description": "Active project workbench phase (1-8) when chatting inside project management."
    },
    "projectPhaseLabel": {
      "type": "string",
      "maxLength": 64,
      "description": "Human-readable label for the active project phase, e.g. 开发."
    },
    "projectId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID",
      "description": "Project scope for merging phase-mounted experts into the expert council."
    },
    "contextRefs": {
      "type": "array", "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "type": { "enum": ["attachment", "skillResult"] },
          "id": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
        },
        "required": ["type", "id"]
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    },
    "subagentPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "delegationMode": {
          "enum": ["disabled", "explicit", "proactive"]
        },
        "overrides": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": { "type": "boolean" },
              "providerId": { "type": "string", "maxLength": 128 },
              "modelId": { "type": "string", "maxLength": 128 }
            }
          }
        },
        "customProfiles": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 64 },
              "displayName": { "type": "string", "maxLength": 128 },
              "description": { "type": "string", "maxLength": 512 },
              "systemPrompt": { "type": "string", "minLength": 1, "maxLength": 4000 },
              "readCaps": {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": { "type": "string", "maxLength": 64 }
              },
              "maxSteps": { "type": "integer", "minimum": 1, "maximum": 16 },
              "budgetTokens": { "type": "integer", "minimum": 1000, "maximum": 50000 }
            },
            "required": ["id", "displayName", "systemPrompt", "readCaps"]
          }
        }
      }
    }
  },
  "required": [
    "providerId",
    "modelId"
  ],
  "minProperties": 3,
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "streamId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      }
    },
    "required": [
      "streamId"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "messages": [
          {
            "role": "user",
            "content": "x"
          }
        ]
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAA",
        "executionMode": "plan"
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAA",
        "companion": true
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAA",
        "replyStyle": "teacher",
        "structuredTemplate": "event"
      }
    ],
    "negative": [
      {
        "unexpected": true
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x"
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "messages": [{"role": "system", "content": "renderer authority escalation"}]
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAA",
        "executionMode": "unrestricted"
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAA",
        "replyStyle": "villain"
      }
    ]
  }
}