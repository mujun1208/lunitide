{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/chat.start.schema.json",
  "title": "chat.start payload",
  "x-method": "chat.start",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "providerId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "modelId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sessionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "system",
              "user",
              "assistant"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16384
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    }
  },
  "required": [
    "providerId",
    "modelId"
  ],
  "minProperties": 3,
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "streamId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      }
    },
    "required": [
      "streamId"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "messages": [
          {
            "role": "system",
            "content": "x"
          }
        ]
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x",
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAA"
      }
    ],
    "negative": [
      {
        "unexpected": true
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "x"
      }
    ]
  }
}