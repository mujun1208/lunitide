{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/context.compact.preview.schema.json",
  "title": "context.compact.preview payload",
  "x-method": "context.compact.preview",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    }
  },
  "required": ["sessionId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "checkpointId": {
        "type": "string",
        "minLength": 26,
        "maxLength": 26
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "sourceStartSeq": {
        "type": "integer",
        "minimum": 1
      },
      "sourceEndSeq": {
        "type": "integer",
        "minimum": 1
      },
      "sourceDigest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      },
      "summaryPreview": {
        "type": "string",
        "minLength": 2,
        "maxLength": 65536
      },
      "humanSummary": {
        "type": "string",
        "maxLength": 32768
      },
      "status": {
        "type": "string"
      }
    },
    "required": [
      "checkpointId",
      "version",
      "sourceStartSeq",
      "sourceEndSeq",
      "sourceDigest",
      "summaryPreview",
      "humanSummary",
      "status"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ],
    "negative": [
      {}
    ]
  }
}
