{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/projectAttachment.list.schema.json",
  "title": "projectAttachment.list payload",
  "x-method": "projectAttachment.list",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "projectId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "phase": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    }
  },
  "required": ["projectId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 200,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attachmentId": {
              "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
            },
            "projectId": {
              "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
            },
            "phase": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            },
            "category": {
              "type": "string",
              "maxLength": 64
            },
            "fileName": {
              "type": "string",
              "minLength": 1,
              "maxLength": 260
            },
            "mimeType": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "size": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10485760
            },
            "digest": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "createdAt": {
              "type": "string",
              "format": "date-time"
            },
            "updatedAt": {
              "type": "string",
              "format": "date-time"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": ["attachmentId", "projectId", "phase", "category", "fileName", "mimeType", "size", "digest", "createdAt", "updatedAt", "version"]
        }
      }
    },
    "required": ["items"]
  },
  "x-examples": {
    "positive": [
      {
        "projectId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "phase": 1
      }
    ],
    "negative": [
      {}
    ]
  }
}
