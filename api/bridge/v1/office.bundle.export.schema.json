{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/office.bundle.export.schema.json",
  "title": "office.bundle.export payload",
  "x-method": "office.bundle.export",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "taskId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "bundleId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "deliveryMode": {
      "type": "string",
      "enum": ["copy", "formal"]
    }
  },
  "required": [
    "taskId",
    "bundleId"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "bundleId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "directory": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096
      },
      "manifestPath": {
        "type": "string",
        "minLength": 0,
        "maxLength": 4096
      },
      "files": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "versionId": {
              "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
            },
            "name": {
              "type": "string",
              "minLength": 0,
              "maxLength": 512
            },
            "path": {
              "type": "string",
              "minLength": 0,
              "maxLength": 4096
            },
            "sha256": {
              "type": "string",
              "minLength": 64,
              "maxLength": 64
            },
            "reused": {
              "type": "boolean"
            }
          },
          "required": [
            "versionId",
            "name",
            "path",
            "sha256",
            "reused"
          ]
        }
      },
      "complete": {
        "type": "boolean"
      },
      "decision": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "decisionId": { "type": "string", "minLength": 0, "maxLength": 128 },
          "versionId": { "type": "string", "minLength": 0, "maxLength": 128 },
          "allowed": { "type": "boolean" },
          "state": { "type": "string", "minLength": 0, "maxLength": 64 },
          "missingChecks": {
            "type": "array",
            "maxItems": 64,
            "items": { "type": "string", "maxLength": 128 }
          }
        }
      }
    },
    "required": [
      "bundleId",
      "directory",
      "manifestPath",
      "files",
      "complete"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "taskId": "01ARZ3NDEKTSV4RRFFQ69G5FAE",
        "bundleId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  }
}
