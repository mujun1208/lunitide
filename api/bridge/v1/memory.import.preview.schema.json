{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/memory.import.preview.schema.json",
  "title": "memory.import.preview payload",
  "x-method": "memory.import.preview",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["sourceArtifactId", "operationId"],
  "properties": {
    "sourceArtifactId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["previewId", "sourceArtifactId", "archiveDigest", "manifestDigest", "databaseRevision", "expiresAt", "counts", "warnings", "operationId"],
    "properties": {
      "previewId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "sourceArtifactId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "archiveDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "databaseRevision": { "type": "integer", "minimum": 1 },
      "expiresAt": { "type": "string", "format": "date-time" },
      "counts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["total", "accepted", "review", "conflicts", "sensitive", "tombstones"],
        "properties": {
          "total": { "type": "integer", "minimum": 0 },
          "accepted": { "type": "integer", "minimum": 0 },
          "review": { "type": "integer", "minimum": 0 },
          "conflicts": { "type": "integer", "minimum": 0 },
          "sensitive": { "type": "integer", "minimum": 0 },
          "tombstones": { "type": "integer", "minimum": 0 }
        }
      },
      "warnings": {
        "type": "array",
        "maxItems": 100,
        "items": { "type": "string", "maxLength": 256 }
      },
      "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
    }
  },
  "x-examples": {
    "positive": [
      {
        "sourceArtifactId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      }
    ],
    "negative": [
      { "sourceArtifactId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" },
      { "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW" },
      {
        "sourceArtifactId": "not-a-ulid",
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      }
    ]
  }
}
