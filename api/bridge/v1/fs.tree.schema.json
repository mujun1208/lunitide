{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/fs.tree.schema.json",
  "title": "fs.tree payload",
  "x-method": "fs.tree",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "leaseId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "fencingToken": {
      "type": "integer",
      "minimum": 1
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    },
    "maxEntries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2048
    }
  },
  "required": ["leaseId", "fencingToken"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/FsTreeResultDTO"
  },
  "x-examples": {
    "positive": [
      {
        "leaseId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "fencingToken": 1,
        "path": "src",
        "maxDepth": 4,
        "maxEntries": 512
      }
    ],
    "negative": [
      {
        "leaseId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      },
      {
        "leaseId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "fencingToken": 0
      }
    ]
  }
}
