{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/widget.archive.schema.json",
  "title": "widget.archive payload",
  "x-method": "widget.archive",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "revision": { "type": "integer", "minimum": 1 }
  },
  "required": ["owner", "id", "revision"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string" },
      "revision": { "type": "integer", "minimum": 1 },
      "owner": { "type": "string" },
      "title": { "type": "string" },
      "status": { "type": "string" }
    },
    "required": ["id", "revision", "owner", "title", "status"]
  },
  "x-examples": {
    "positive": [{ "owner": "u1", "id": "w1", "revision": 1 }],
    "negative": [{ "unexpected": true }, { "owner": "u1" }]
  }
}
