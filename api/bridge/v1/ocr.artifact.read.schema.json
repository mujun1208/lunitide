{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/ocr.artifact.read.schema.json",
  "title": "ocr.artifact.read payload",
  "x-method": "ocr.artifact.read",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["artifactId", "offset", "limit"],
  "properties": {
    "artifactId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "offset": { "type": "integer", "minimum": 0 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 65536 }
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["base64", "nextOffset", "eof", "sha256", "totalBytes"],
    "properties": {
      "base64": { "type": "string" },
      "nextOffset": { "type": "integer", "minimum": 0 },
      "eof": { "type": "boolean" },
      "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
      "totalBytes": { "type": "integer", "minimum": 0 }
    }
  },
  "x-examples": {
    "positive": [{
      "artifactId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
      "offset": 0,
      "limit": 4096
    }],
    "negative": [
      { "artifactId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "offset": 0, "limit": 0 },
      { "artifactId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "path": "C:\\\\ocr\\\\out.txt" },
      { "offset": 0, "limit": 4096 }
    ]
  }
}
