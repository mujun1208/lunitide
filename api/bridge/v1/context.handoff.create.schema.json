{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/context.handoff.create.schema.json",
  "title": "context.handoff.create payload",
  "x-method": "context.handoff.create",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sourceSessionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "checkpointId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "recentMessageIds": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      }
    },
    "activeTasksJson": {
      "type": "string",
      "maxLength": 65536
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["sourceSessionId", "checkpointId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "capsuleId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "sourceSessionId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "checkpointId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "status": {
        "type": "string",
        "enum": ["active", "activated", "expired", "revoked"]
      },
      "digest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "expiresAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": ["capsuleId", "sourceSessionId", "checkpointId", "status", "digest", "createdAt"]
  },
  "x-examples": {
    "positive": [
      {
        "sourceSessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "checkpointId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ],
    "negative": [
      {}
    ]
  }
}
