{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/complexity.decide.schema.json",
  "title": "complexity.decide payload",
  "x-method": "complexity.decide",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "signals": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "messageCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "turnCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "toolCallCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "distinctTools": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "fileEditCount": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "distinctFiles": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "estTokens": { "type": "integer", "minimum": 0, "maximum": 1000000000 },
        "errorCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "retryCount": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "delegationHints": { "type": "integer", "minimum": 0, "maximum": 100000 },
        "parallelismHint": { "type": "boolean" },
        "securityRelevant": { "type": "boolean" },
        "irreversibleOps": { "type": "boolean" },
        "crossModuleScope": { "type": "boolean" }
      },
      "required": ["messageCount", "turnCount", "toolCallCount", "distinctTools", "fileEditCount", "distinctFiles", "estTokens", "errorCount", "retryCount", "delegationHints", "parallelismHint", "securityRelevant", "irreversibleOps", "crossModuleScope"]
    }
  },
  "required": ["sessionId", "signals"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "decisionId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "tier": {
        "enum": ["simple", "moderate", "complex", "high-risk"]
      },
      "routedPath": {
        "enum": ["single", "planned-single", "delegated"]
      },
      "reasonCodes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": { "type": "string", "minLength": 1, "maxLength": 64 }
      },
      "confidence": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "required": ["decisionId", "tier", "routedPath", "reasonCodes", "confidence"]
  },
  "x-examples": {
    "positive": [
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAY",
        "signals": {
          "messageCount": 3,
          "turnCount": 2,
          "toolCallCount": 1,
          "distinctTools": 1,
          "fileEditCount": 0,
          "distinctFiles": 0,
          "estTokens": 2000,
          "errorCount": 0,
          "retryCount": 0,
          "delegationHints": 0,
          "parallelismHint": false,
          "securityRelevant": false,
          "irreversibleOps": false,
          "crossModuleScope": false
        }
      }
    ],
    "negative": [
      {
        "sessionId": "",
        "signals": {
          "messageCount": 0,
          "turnCount": 0,
          "toolCallCount": 0,
          "distinctTools": 0,
          "fileEditCount": 0,
          "distinctFiles": 0,
          "estTokens": 0,
          "errorCount": 0,
          "retryCount": 0,
          "delegationHints": 0,
          "parallelismHint": false,
          "securityRelevant": false,
          "irreversibleOps": false,
          "crossModuleScope": false
        }
      },
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAY",
        "signals": {
          "messageCount": -1,
          "turnCount": 0,
          "toolCallCount": 0,
          "distinctTools": 0,
          "fileEditCount": 0,
          "distinctFiles": 0,
          "estTokens": 0,
          "errorCount": 0,
          "retryCount": 0,
          "delegationHints": 0,
          "parallelismHint": false,
          "securityRelevant": false,
          "irreversibleOps": false,
          "crossModuleScope": false
        }
      }
    ]
  }
}
