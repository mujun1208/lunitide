{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/release.promote.schema.json",
  "title": "release.promote payload",
  "x-method": "release.promote",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "packageId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "targetEnv": {
      "type": "string",
      "enum": ["dev", "stage", "prod"]
    },
    "policyContext": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "packageId",
    "targetEnv",
    "policyContext",
    "requestId"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "promotionId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "state": {
        "type": "string",
        "enum": ["planned", "applying", "verifying", "done", "rolled_back"]
      }
    },
    "required": [
      "promotionId",
      "state"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "packageId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "targetEnv": "dev",
        "policyContext": {
          "requestedBy": "u-release-9"
        },
        "requestId": "prm-001"
      }
    ],
    "negative": [
      {
        "packageId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "targetEnv": "qa",
        "policyContext": {
          "requestedBy": "u-release-9"
        },
        "requestId": "prm-001"
      }
    ]
  }
}