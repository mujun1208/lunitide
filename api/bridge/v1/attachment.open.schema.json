{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/attachment.open.schema.json",
  "title": "attachment.open payload",
  "x-method": "attachment.open",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "attachmentId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "reveal": {
      "type": "boolean",
      "description": "true 打开所在文件夹并选中文件；默认 false 用系统默认程序按原始类型打开。"
    }
  },
  "required": ["attachmentId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "opened": { "type": "string", "minLength": 1, "maxLength": 1024 }
    },
    "required": ["opened"]
  },
  "x-examples": {
    "positive": [
      {
        "attachmentId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ],
    "negative": [
      {}
    ]
  }
}
