{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/automation.dispatch.schema.json",
  "title": "automation.dispatch payload",
  "x-method": "automation.dispatch",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "bundleId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "bundleVersion": {
      "type": "integer",
      "minimum": 1
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "actions": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": [
        "type"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxTokens": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "maxTokens"
      ]
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "bundleId",
    "bundleVersion",
    "trigger",
    "budget",
    "requestId"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "state": {
        "type": "string",
        "enum": [
          "dispatched",
          "blocked",
          "waiting_confirmation"
        ]
      },
      "executionStarted": {
        "type": "boolean",
        "const": false
      }
    },
    "required": [
      "runId",
      "state",
      "executionStarted"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "bundleId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "bundleVersion": 2,
        "trigger": {
          "type": "manual"
        },
        "budget": {
          "maxTokens": 1000
        },
        "requestId": "req-4"
      }
    ],
    "negative": [
      {
        "bundleId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "bundleVersion": 0,
        "trigger": {},
        "budget": {},
        "requestId": "req-4"
      }
    ]
  }
}
