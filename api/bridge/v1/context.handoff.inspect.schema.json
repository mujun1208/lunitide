{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/context.handoff.inspect.schema.json",
  "title": "context.handoff.inspect payload",
  "x-method": "context.handoff.inspect",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "capsuleId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    }
  },
  "required": ["capsuleId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "capsuleId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "sourceSessionId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "checkpointId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "status": {
        "type": "string",
        "enum": ["active", "activated", "expired", "revoked"]
      },
      "digest": {
        "type": "string",
        "minLength": 64,
        "maxLength": 64
      },
      "createdAt": {
        "type": "string",
        "format": "date-time"
      },
      "expiresAt": {
        "type": "string",
        "format": "date-time"
      },
      "summaryPreview": {
        "type": "string",
        "maxLength": 65536
      },
      "humanSummary": {
        "type": "string",
        "maxLength": 32768
      },
      "sourceStartSeq": {
        "type": "integer",
        "minimum": 1
      },
      "sourceEndSeq": {
        "type": "integer",
        "minimum": 1
      },
      "sourceDeleted": {
        "type": "boolean"
      }
    },
    "required": ["capsuleId", "sourceSessionId", "checkpointId", "status", "digest", "createdAt", "sourceDeleted"]
  },
  "x-examples": {
    "positive": [
      {
        "capsuleId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ],
    "negative": [
      {}
    ]
  }
}
