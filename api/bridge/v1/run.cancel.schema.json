{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/run.cancel.schema.json",
  "title": "run.cancel payload",
  "x-method": "run.cancel",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "reason": {
      "enum": ["user", "policy", "timeout"]
    }
  },
  "required": ["runId", "reason"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "runId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "status": {
        "enum": ["cancelled", "outcome_unknown"]
      },
      "releasedAt": {
        "type": "string",
        "format": "date-time"
      }
    },
    "required": ["runId", "status", "releasedAt"]
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "reason": "user"
      },
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "reason": "timeout"
      }
    ],
    "negative": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "reason": "because-i-said-so"
      },
      {
        "reason": "user"
      }
    ]
  }
}
