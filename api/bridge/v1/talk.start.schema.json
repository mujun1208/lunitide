        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      }
    ],
    "negative": [
      {
        "modelId": "glm-4-air"
      },
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "modelId": "glm-4-air",
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAW",
        "unexpected": 1
      }
    ]
  }
