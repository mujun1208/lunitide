{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/productHub.refresh.schema.json",
  "title": "productHub.refresh payload",
  "x-method": "productHub.refresh",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionToken": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "required": ["sessionToken"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "editionId": { "type": "string" },
      "generatedAt": { "type": "string" },
      "cardCount": { "type": "integer" },
      "healthScore": { "type": "integer" },
      "added": { "type": "integer" },
      "updated": { "type": "integer" },
      "removed": { "type": "integer" },
      "reportMarkdown": { "type": "string" },
      "reportHtml": { "type": "string" }
    },
    "required": ["editionId", "cardCount", "healthScore", "reportMarkdown", "reportHtml"]
  },
  "x-examples": {
    "positive": [{ "sessionToken": "ab" }],
    "negative": [{ "sessionToken": "" }]
  }
}
