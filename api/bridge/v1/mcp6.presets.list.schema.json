{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/mcp6.presets.list.schema.json",
  "title": "mcp6.presets.list payload",
  "x-method": "mcp6.presets.list",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 48,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "description": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "transport": {
              "type": "string",
              "enum": [
                "stdio",
                "https"
              ]
            },
            "command": {
              "type": "string",
              "enum": [
                "npx",
                "uvx",
                "node",
                ""
              ]
            },
            "args": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "needsArgs": {
              "type": "boolean"
            },
            "argPlaceholder": {
              "type": "string",
              "minLength": 2,
              "maxLength": 32
            },
            "argHint": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "argDefault": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "category": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048,
              "pattern": "^https://"
            },
            "needsCredential": {
              "type": "boolean"
            },
            "credentialEnvs": {
              "type": "array",
              "maxItems": 16,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
              }
            },
            "setupUrl": {
              "type": "string",
              "pattern": "^https://",
              "maxLength": 2048
            }
          },
          "required": [
            "id",
            "name",
            "description",
            "transport",
            "command",
            "args",
            "needsArgs",
            "category"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "transport": {
                    "const": "https"
                  }
                }
              },
              "then": {
                "required": [
                  "url"
                ],
                "properties": {
                  "command": {
                    "const": ""
                  },
                  "args": {
                    "maxItems": 0
                  },
                  "needsArgs": {
                    "const": false
                  }
                }
              },
              "else": {
                "properties": {
                  "args": {
                    "minItems": 1
                  },
                  "command": {
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    },
    "required": [
      "items"
    ]
  },
  "x-examples": {
    "positive": [
      {}
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  }
}
