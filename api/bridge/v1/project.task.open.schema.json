    "workSessionId": { "type": "string", "maxLength": 26 },
    "hubThreadId": { "type": "string", "maxLength": 26 }
  },
  "required": ["projectId", "itemId"],
  "x-result": { "type": "object", "additionalProperties": true },
  "x-examples": {
    "positive": [{ "projectId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "itemId": "F001", "executor": "lunitide" }],
    "negative": [{ "projectId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" }]
  }
}
