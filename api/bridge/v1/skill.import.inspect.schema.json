{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/skill.import.inspect.schema.json",
  "title": "skill.import.inspect payload",
  "x-method": "skill.import.inspect",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidateId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 1
    },
    "noticeRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "signature": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8192
    },
    "sourceAttestation": {
      "type": "string",
      "minLength": 2,
      "maxLength": 16384
    }
  },
  "required": [
    "candidateId",
    "expectedVersion"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "candidateId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "state": {
        "enum": [
          "inspected"
        ]
      },
      "version": {
        "type": "integer",
        "minimum": 1
      },
      "summary": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "license": {
            "type": "string",
            "maxLength": 128
          },
          "archiveHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "skippedFiles": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "description",
          "license",
          "archiveHash",
          "skippedFiles"
        ]
      },
      "skillId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID",
        "description": "Created runtime draft skill ID; returned only for an approved source skill import."
      }
    },
    "required": [
      "candidateId",
      "state",
      "version"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "candidateId": "01ARZ3NDEKTSV4RRFFQ69G5FAY",
        "expectedVersion": 1,
        "noticeRef": "NOTICE",
        "signature": "sig-1"
      }
    ],
    "negative": [
      {
        "candidateId": "not-a-ulid",
        "expectedVersion": 1
      },
      {
        "candidateId": "01ARZ3NDEKTSV4RRFFQ69G5FAY",
        "expectedVersion": 0
      }
    ]
  }
}
