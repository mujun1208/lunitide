{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/chat.turn.get.schema.json",
  "title": "chat.turn.get payload",
  "x-method": "chat.turn.get",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    }
  },
  "required": ["sessionId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "status": {
        "enum": ["", "running", "completed", "cancelled", "interrupted"]
      },
      "persistFailed": {
        "type": "boolean"
      },
      "persistDraft": {
        "type": "string",
        "maxLength": 8192
      }
    },
    "required": ["status", "persistFailed", "persistDraft"]
  },
  "x-examples": {
    "positive": [
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ],
    "negative": [
      {
        "unexpected": true
      },
      {
        "sessionId": "not-a-ulid"
      }
    ]
  }
}
