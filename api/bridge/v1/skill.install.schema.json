{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/skill.install.schema.json",
  "title": "skill.install payload",
  "x-method": "skill.install",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "templateId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9-]+$" }
  },
  "required": ["templateId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "skillId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "name": { "type": "string" },
      "status": { "enum": ["draft"] }
    },
    "required": ["skillId", "name", "status"]
  },
  "x-examples": {
    "positive": [{ "templateId": "meeting-minutes" }],
    "negative": [{ "templateId": "" }]
  }
}
