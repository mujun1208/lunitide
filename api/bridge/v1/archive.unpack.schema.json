{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/archive.unpack.schema.json",
  "title": "archive.unpack payload",
  "x-method": "archive.unpack",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "archivePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "destDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "maxEntries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": ["runId", "archivePath", "destDir", "maxEntries", "maxBytes", "requestId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "entryCount": {
        "type": "integer",
        "minimum": 0
      },
      "totalBytes": {
        "type": "integer",
        "minimum": 0
      },
      "rejectedEntries": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required": ["entryCount", "totalBytes"]
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "archivePath": "packages/cr-42.zip",
        "destDir": "work/cr-42",
        "maxEntries": 2000,
        "maxBytes": 104857600,
        "requestId": "req-5e6f7a"
      }
    ],
    "negative": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "archivePath": "packages/bomb.zip",
        "destDir": "work/bomb",
        "maxEntries": 0,
        "maxBytes": 104857600,
        "requestId": "req-5e6f7b"
      }
    ]
  }
}
