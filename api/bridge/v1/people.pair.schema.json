{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/people.pair.schema.json",
  "title": "people.pair payload",
  "x-method": "people.pair",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "pairingCode": { "type": "string", "pattern": "^[0-9]{6}$" },
    "subjectId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "nickname": { "type": "string", "minLength": 1, "maxLength": 64 },
    "publicKey": { "type": "string", "maxLength": 64 },
    "department": { "type": "string", "maxLength": 128 },
    "title": { "type": "string", "maxLength": 128 },
    "orgName": { "type": "string", "maxLength": 128 }
  },
  "required": ["pairingCode"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/PeopleContactDTO"
  },
  "x-examples": {
    "positive": [{ "pairingCode": "123456", "nickname": "同事甲" }],
    "negative": [{ "pairingCode": "abc" }]
  }
}
