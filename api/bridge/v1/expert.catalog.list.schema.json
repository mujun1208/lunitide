            "description": { "type": "string", "maxLength": 280 },
            "category": { "type": "string", "minLength": 1, "maxLength": 64 },
            "division": { "type": "string", "enum": ["engineering", "design", "product", "project-management", "testing", "security", "operations", "data"] },
            "origin": { "type": "string", "minLength": 1, "maxLength": 64 },
            "usage": { "type": "string", "enum": ["chat", "project", "both"] },
            "scene": { "type": "string", "maxLength": 64 },
            "emoji": { "type": "string", "maxLength": 8 },
            "version": { "type": "string", "minLength": 1, "maxLength": 32 },
            "kind": { "type": "string", "enum": ["prompt_skill", "agent"] },
            "installed": { "type": "boolean" }
          },
          "required": ["id", "name", "displayName", "description", "category", "division", "origin", "usage", "version", "installed"]
        }
      }
    },
    "required": ["items"]
