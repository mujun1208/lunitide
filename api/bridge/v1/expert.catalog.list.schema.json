{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/expert.catalog.list.schema.json",
  "title": "expert.catalog.list payload",
  "x-method": "expert.catalog.list",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "minItems": 0,
        "maxItems": 400,
        "items": {
