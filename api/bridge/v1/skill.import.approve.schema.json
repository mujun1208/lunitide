{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/skill.import.approve.schema.json",
  "title": "skill.import.approve payload",
  "x-method": "skill.import.approve",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "candidateId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 1
    },
    "approval": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "additionalProperties": { "type": "string", "maxLength": 2048 }
    },
    "manifest": {
      "type": "string",
      "minLength": 100,
      "maxLength": 262144
    }
  },
  "required": ["candidateId", "expectedVersion", "approval"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "candidateId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "state": {
        "enum": ["approved"]
      },
      "version": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": ["candidateId", "state", "version"]
  },
  "x-examples": {
    "positive": [
      {
        "candidateId": "01ARZ3NDEKTSV4RRFFQ69G5FAY",
        "expectedVersion": 7,
        "approval": { "approver": "product-owner" }
      }
    ],
    "negative": [
      {
        "candidateId": "01ARZ3NDEKTSV4RRFFQ69G5FAY",
        "expectedVersion": 7,
        "approval": {}
      },
      {
        "candidateId": "01ARZ3NDEKTSV4RRFFQ69G5FAY",
        "expectedVersion": 7
      }
    ]
  }
}
