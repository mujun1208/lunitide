{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/web.fetch.schema.json",
  "title": "web.fetch payload",
  "x-method": "web.fetch",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "format": "uri"
    }
  },
  "required": ["runId", "url"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/WebFetchResultDTO"
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "url": "https://example.com/doc"
      }
    ],
    "negative": [
      {
        "runId": "bad-id",
        "url": "https://example.com/doc"
      }
    ]
  }
}
