{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/system.diagnostics.schema.json",
  "title": "system.diagnostics payload",
  "x-method": "system.diagnostics",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "x-examples": {
    "positive": [
      {}
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "state": {
        "type": "string",
        "enum": [
          "healthy",
          "degraded"
        ]
      },
      "checkedAt": {
        "type": "string",
        "format": "date-time"
      },
      "traceId": {
        "type": "string",
        "minLength": 26,
        "maxLength": 26
      },
      "components": {
        "type": "array",
        "maxItems": 32,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "maxLength": 64
            },
            "name": {
              "type": "string",
              "maxLength": 64
            },
            "state": {
              "type": "string",
              "enum": [
                "healthy",
                "configured",
                "not_configured",
                "disabled",
                "degraded"
              ]
            },
            "detail": {
              "type": "string",
              "maxLength": 256
            },
            "code": {
              "type": "string",
              "maxLength": 64
            },
            "durationMs": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "id",
            "name",
            "state",
            "detail",
            "durationMs"
          ]
        }
      }
    },
    "required": [
      "state",
      "checkedAt",
      "traceId",
      "components"
    ]
  }
