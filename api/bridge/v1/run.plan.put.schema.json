{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/run.plan.put.schema.json",
  "title": "run.plan.put payload",
  "x-method": "run.plan.put",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 0
    },
    "plan": {
      "type": "object"
    }
  },
  "required": ["runId", "expectedVersion", "plan"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/RunPlanPutResultDTO"
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedVersion": 0,
        "plan": {
          "goal": "summarize the design doc",
          "steps": [
            { "kind": "fs.read", "path": "docs/design.md" },
            { "kind": "web.fetch", "url": "https://example.com/ref" }
          ]
        }
      }
    ],
    "negative": [
      {
        "runId": "bad-id",
        "expectedVersion": 0,
        "plan": {}
      },
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedVersion": -1,
        "plan": {}
      },
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedVersion": 0,
        "plan": "not-an-object"
      }
    ]
  }
}
