    "qty": { "type": "number", "exclusiveMinimum": 0 },
    "tailNo": { "type": "string", "minLength": 0, "maxLength": 32 },
    "wo": { "type": "string", "minLength": 0, "maxLength": 64 },
    "tech": { "type": "string", "minLength": 0, "maxLength": 64 }
  },
  "required": ["lotId", "qty"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": { "ok": { "type": "boolean" } },
    "required": ["ok"]
  },
  "x-examples": {
    "positive": [{ "lotId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "qty": 2, "tailNo": "B-1" }],
    "negative": [{ "unexpected": true }]
  }
}
