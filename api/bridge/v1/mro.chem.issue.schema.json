{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/mro.chem.issue.schema.json",
  "title": "mro.chem.issue payload",
  "x-method": "mro.chem.issue",
  "x-owner": "engine",
  "x-enabled": true,
