{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/http.download.schema.json",
  "title": "http.download payload",
  "x-method": "http.download",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "url": {
      "type": "string",
      "pattern": "^https?://",
      "maxLength": 2048
    },
    "destPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "expectedSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": ["runId", "url", "destPath", "maxBytes", "requestId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "taskId": {
        "type": "string"
      },
      "state": {
        "type": "string",
        "enum": ["completed"]
      },
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "bytes": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": ["taskId", "state", "sha256", "bytes"]
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "url": "https://example.com/datasets/spec.zip",
        "destPath": "downloads/spec.zip",
        "maxBytes": 10485760,
        "requestId": "req-9a1b2c"
      }
    ],
    "negative": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "url": "https://example.com/datasets/spec.zip",
        "destPath": "downloads/spec.zip",
        "maxBytes": 0,
        "requestId": "req-9a1b2d"
      }
    ]
  }
}
