{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/datasource.query.schema.json",
  "title": "datasource.query payload",
  "x-method": "datasource.query",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "connectionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "bindingId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "sql": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "maxRows": { "type": "integer", "minimum": 1, "maximum": 1000 }
  },
  "required": ["sql"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "columns": { "type": "array", "maxItems": 64, "items": { "type": "string" } },
      "rows": { "type": "array", "maxItems": 1000 },
      "rowCount": { "type": "integer", "minimum": 0 },
      "truncated": { "type": "boolean" }
    },
    "required": ["columns", "rowCount", "truncated"]
  },
  "x-examples": {
    "positive": [
      {
        "connectionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "sql": "SELECT 1",
        "maxRows": 10
      }
    ],
    "negative": [
      {
        "sql": ""
      }
    ]
  }
}
