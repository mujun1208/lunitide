{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/identity.update.schema.json",
  "title": "identity.update payload",
  "x-method": "identity.update",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "nickname": { "type": "string", "minLength": 1, "maxLength": 64 },
    "avatar": { "type": "string", "maxLength": 65536 },
    "status": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/IdentityStatus" },
    "department": { "type": "string", "maxLength": 128 },
    "title": { "type": "string", "maxLength": 128 },
    "orgName": { "type": "string", "maxLength": 128 },
    "bio": { "type": "string", "maxLength": 2000 },
    "regeneratePairingCode": { "type": "boolean" }
  },
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/IdentityDTO"
  },
  "x-examples": {
    "positive": [{ "nickname": "mu", "status": "away", "department": "研发" }],
    "negative": [{ "nickname": "" }]
  }
}
