{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/people.thread.open.schema.json",
  "title": "people.thread.open payload",
  "x-method": "people.thread.open",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "threadId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "peerSubjectId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "thread": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/PeopleThreadDTO" },
      "messages": {
        "type": "array",
        "maxItems": 200,
        "items": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/PeopleMessageDTO" }
      }
    },
    "required": ["thread", "messages"]
  },
  "x-examples": {
    "positive": [{ "peerSubjectId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" }],
    "negative": [{ "threadId": "nope" }]
  }
}
