{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/remote.access.status.schema.json",
  "title": "remote.access.status payload",
  "x-method": "remote.access.status",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {},
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "enabled": {
        "type": "boolean"
      },
      "port": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      },
      "addresses": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      },
      "certFingerprint": {
        "type": "string",
        "description": "DER SHA-256 hex 的前 16 位，进二维码供手机锁定证书。",
        "pattern": "^[0-9a-f]{16}$"
      },
      "keepAwake": {
        "type": "boolean"
      },
      "activeDevices": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": [
      "enabled",
      "port",
      "addresses",
      "keepAwake",
      "activeDevices"
    ]
  },
  "x-examples": {
    "positive": [
      {}
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  }
}
