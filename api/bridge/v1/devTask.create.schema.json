{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/devTask.create.schema.json",
  "title": "devTask.create payload",
  "x-method": "devTask.create",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stageRunId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "priority": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "acceptanceDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "assigneeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": [
    "stageRunId",
    "title",
    "priority",
    "risk",
    "acceptanceDigest"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "taskId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
      },
      "state": {
        "enum": [
          "draft"
        ]
      },
      "lockVersion": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "taskId",
      "state",
      "lockVersion"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "stageRunId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "title": "implement gate evaluator",
        "priority": "P1",
        "risk": "medium",
        "acceptanceDigest": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
      }
    ],
    "negative": [
      {
        "stageRunId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "title": "t",
        "priority": "P9",
        "risk": "medium",
        "acceptanceDigest": "a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1a1"
      }
    ]
  }
}
