{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/talk.append.schema.json",
  "title": "talk.append payload",
  "x-method": "talk.append",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "pcm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 65536,
      "contentEncoding": "base64"
    }
  },
  "required": ["sessionId", "pcm"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "accepted": {
        "type": "boolean"
      }
    },
    "required": ["accepted"]
  },
  "x-examples": {
    "positive": [
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "pcm": "AAAA"
      }
    ],
    "negative": [
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      },
      {
        "sessionId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "pcm": "",
        "unexpected": 1
      }
    ]
  }
}
