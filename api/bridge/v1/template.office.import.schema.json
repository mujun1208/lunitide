{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/template.office.import.schema.json",
  "title": "template.office.import payload",
  "x-method": "template.office.import",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "fileName": { "type": "string", "minLength": 1, "maxLength": 260 },
    "uploadId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "contentBase64": { "type": "string", "minLength": 1 }
  },
  "required": ["fileName"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "orgId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "templateCode": { "type": "string", "minLength": 4, "maxLength": 16 },
      "name": { "type": "string" },
      "templateType": { "enum": ["ppt", "word", "excel"] },
      "documentType": { "type": "string" },
      "description": { "type": "string" },
      "client": { "type": "string" },
      "mimeType": { "type": "string" },
      "fileName": { "type": "string" },
      "filePath": { "type": "string" },
      "status": { "enum": ["draft"] },
      "createdAt": { "type": "string", "format": "date-time" },
      "updatedAt": { "type": "string", "format": "date-time" },
      "version": { "type": "integer", "minimum": 1 }
    },
    "required": ["id", "templateCode", "name", "templateType", "status", "createdAt", "updatedAt", "version"]
  },
  "x-examples": {
    "positive": [{ "fileName": "quarter.pptx", "contentBase64": "dGVzdA==" }],
    "negative": [{}]
  }
}
