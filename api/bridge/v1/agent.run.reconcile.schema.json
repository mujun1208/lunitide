{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/agent.run.reconcile.schema.json",
  "title": "agent.run.reconcile payload",
  "x-method": "agent.run.reconcile",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "expectedVersion": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": ["runId", "expectedVersion"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "run": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/AgentRunDTO"
      },
      "reconciledEffects": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": ["run", "reconciledEffects"]
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedVersion": 2
      }
    ],
    "negative": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ]
  }
}
