{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/widget.update.schema.json",
  "title": "widget.update payload",
  "x-method": "widget.update",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "owner": { "type": "string", "minLength": 1, "maxLength": 128 },
    "id": { "type": "string", "minLength": 1, "maxLength": 64 },
    "revision": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "layout": { "type": "string", "maxLength": 32 },
    "widgets": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "enum": ["timer", "checklist", "metric", "table", "bar", "progress", "todo", "checkin"] },
          "state": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
              "running": { "type": "boolean" },
              "updatedAt": { "type": "string", "maxLength": 40 },
              "value": { "type": "string", "maxLength": 64 },
              "unit": { "type": "string", "maxLength": 16 },
              "percent": { "type": "integer", "minimum": 0, "maximum": 100 },
              "rows": { "type": "string", "maxLength": 500 },
              "checked": { "type": "string", "maxLength": 500 },
              "items": { "type": "string", "maxLength": 500 }
            }
          }
        },
        "required": ["id", "kind"]
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1, "maxLength": 64 },
          "kind": { "enum": ["local.toggle", "local.complete", "item.archive"] }
        },
        "required": ["id", "kind"]
      }
    }
  },
  "required": ["owner", "id", "revision", "title"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string" },
      "revision": { "type": "integer", "minimum": 1 },
      "owner": { "type": "string" },
      "title": { "type": "string" },
      "status": { "type": "string" }
    },
    "required": ["id", "revision", "owner", "title", "status"]
  },
  "x-examples": {
    "positive": [
      { "owner": "u1", "id": "w1", "revision": 1, "title": "timer", "widgets": [{ "id": "a", "kind": "timer" }] }
    ],
    "negative": [
      { "unexpected": true },
      { "owner": "u1", "id": "w1", "title": "x" }
    ]
  }
}
