{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/provider.credential.submit.schema.json",
  "title": "provider.credential.submit payload",
  "x-method": "provider.credential.submit",
  "x-owner": "host",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "providerId": {"$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"}
          },
          "required": ["providerId"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "draftFingerprint": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$",
              "description": "Stable SHA-256 fingerprint of the provider draft scope (protocol and normalized origin)."
            }
          },
          "required": ["draftFingerprint"]
        }
      ]
    },
    "protocol": {"$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ProviderProtocol"},
    "origin": {"type":"string","format":"uri"},
    "request": {"type":"object","description":"Exact create/update/backup.add payload without credentialSubmissionId; canonical JSON is digest-bound to the token."},
    "credential": {
      "type": "string",
      "minLength": 1,
      "maxLength": 61440,
      "description": "Host-owned secret input. It must never be echoed or included in public DTOs."
    }
  },
  "required": [
    "scope",
    "credential",
    "request"
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "credentialSubmissionId": {
        "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID",
        "description": "Opaque one-time token consumable by provider.create, provider.update, or provider.credential.backup.add."
      },
      "expiresAt": {
        "type": "string",
        "format": "date-time",
        "description": "Short TTL expiry; implementations must not issue a token valid for more than five minutes."
      },
      "providerId": {"$ref":"https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"},
      "expiresInSeconds": {
        "type": "integer",
        "minimum": 1,
        "maximum": 300
      }
    },
    "required": [
      "credentialSubmissionId",
      "expiresAt",
      "expiresInSeconds",
      "providerId"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "scope": {"draftFingerprint": "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"},
        "protocol": "openai_compatible",
        "origin": "https://example.com",
        "credential": "x",
        "request": {"name":"x","protocol":"openai_compatible","baseUrl":"https://example.com","models":[{"modelId":"m","displayName":"M","isDefault":true}]}
      }
    ],
    "negative": [
      {
        "unexpected": true
      }
    ]
  }
}