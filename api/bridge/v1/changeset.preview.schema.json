{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/changeset.preview.schema.json",
  "title": "changeset.preview payload",
  "x-method": "changeset.preview",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "leaseId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "fencingToken": {
      "type": "integer",
      "minimum": 1
    },
    "ops": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "create"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "content": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "required": ["op", "path", "content"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "update"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "content": {
                "type": "string",
                "maxLength": 1048576
              }
            },
            "required": ["op", "path", "content"]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "op": {
                "const": "delete"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "required": ["op", "path"]
          }
        ]
      }
    }
  },
  "required": ["runId", "leaseId", "fencingToken", "ops"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ChangeSetPreviewResultDTO"
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "leaseId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "fencingToken": 1,
        "ops": [
          {
            "op": "create",
            "path": "docs/plan.md",
            "content": "# Plan\n"
          },
          {
            "op": "update",
            "path": "src/main.go",
            "content": "package main\n"
          },
          {
            "op": "delete",
            "path": "tmp/stale.txt"
          }
        ]
      }
    ],
    "negative": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "leaseId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "fencingToken": 1,
        "ops": [
          {
            "op": "delete",
            "path": "tmp/stale.txt",
            "content": "not allowed"
          }
        ]
      }
    ]
  }
}
