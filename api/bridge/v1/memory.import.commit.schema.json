{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/memory.import.commit.schema.json",
  "title": "memory.import.commit payload",
  "x-method": "memory.import.commit",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["previewId", "archiveDigest", "manifestDigest", "expectedDatabaseRevision", "operationId"],
  "properties": {
    "previewId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "archiveDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "manifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "expectedDatabaseRevision": { "type": "integer", "minimum": 1 },
    "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["previewId", "state", "importedCount", "reviewCount", "skippedCount", "conflictCount", "databaseRevision", "operationId"],
    "properties": {
      "previewId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "state": { "type": "string", "const": "committed" },
      "importedCount": { "type": "integer", "minimum": 0 },
      "reviewCount": { "type": "integer", "minimum": 0 },
      "skippedCount": { "type": "integer", "minimum": 0 },
      "conflictCount": { "type": "integer", "minimum": 0 },
      "databaseRevision": { "type": "integer", "minimum": 1 },
      "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
    }
  },
  "x-examples": {
    "positive": [
      {
        "previewId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "archiveDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "manifestDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "expectedDatabaseRevision": 1,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      }
    ],
    "negative": [
      {
        "previewId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "archiveDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "manifestDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "expectedDatabaseRevision": 0,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      },
      {
        "previewId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
        "expectedDatabaseRevision": 1,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      },
      {
        "archiveDigest": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "manifestDigest": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
        "expectedDatabaseRevision": 1,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      }
    ]
  }
}
