{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://lunitide.local/schema/bridge/v1/mcp.credential.set.schema.json",
 "title":"mcp.credential.set payload","x-method":"mcp.credential.set","x-owner":"host","x-enabled":true,
 "type":"object","additionalProperties":false,
 "properties":{
  "endpointId":{"type":"string","minLength":1,"maxLength":128},
  "expectedVersion":{"type":"integer","minimum":0},
  "env":{"type":"string","pattern":"^[A-Z][A-Z0-9_]{0,63}$"},
  "credential":{"type":"string","minLength":1,"maxLength":16384},
  "remove":{"type":"boolean"},
  "requestId":{"type":"string","pattern":"^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$"}
 },
 "required":["endpointId","expectedVersion","requestId"],
 "oneOf":[{"required":["credential"],"properties":{"credential":{},"remove":{"const":false}}},{"required":["remove"],"properties":{"remove":{"const":true}},"not":{"required":["credential"],"properties":{"credential":{}}}}],
 "x-result":{"type":"object","additionalProperties":false,"properties":{"configured":{"type":"boolean"},"securityVersion":{"type":"integer","minimum":0}},"required":["configured","securityVersion"]},
 "x-examples":{"positive":[{"endpointId":"mcp-fixture","expectedVersion":0,"credential":"fixture","requestId":"01234567-0123-0123-0123-0123456789ab"}],"negative":[{"endpointId":"mcp-fixture","expectedVersion":0,"requestId":"01234567-0123-0123-0123-0123456789ab"}]}
}
