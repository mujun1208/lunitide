	"budget": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/AgentRunBudgetDTO" }
  },
  "required": ["runId", "expectedVersion", "budget"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/AgentRunDTO"
