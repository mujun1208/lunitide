{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/agent.run.resume.schema.json",
  "title": "agent.run.resume payload",
  "x-method": "agent.run.resume",
  "x-owner": "engine",
