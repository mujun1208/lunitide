        "budget": {
          "maxModelTurns": 16,
          "maxToolCalls": 64,
          "maxTokens": 200000,
          "maxCostMicros": 1000000,
          "maxWallClockSeconds": 7200,
          "maxOutputBytes": 2097152,
          "maxRetries": 6,
          "maxNoProgress": 10,
          "hardCeiling": true
        }
      }
    ],
    "negative": [
      {
        "runId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
