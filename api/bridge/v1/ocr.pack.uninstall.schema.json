{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/ocr.pack.uninstall.schema.json",
  "title": "ocr.pack.uninstall payload",
  "x-method": "ocr.pack.uninstall",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["packId", "expectedRevision", "confirmed", "operationId"],
  "properties": {
    "packId": { "type": "string", "const": "paddleocr-vl-1.6" },
    "expectedRevision": { "type": "integer", "minimum": 1 },
    "confirmed": { "const": true },
    "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["requestId", "operationId", "activityId", "accepted", "packId", "phase", "packRevision", "operationRevision"],
    "properties": {
      "requestId": { "type": "string", "minLength": 1, "maxLength": 128 },
      "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "activityId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
      "accepted": { "type": "boolean" },
      "packId": { "type": "string", "const": "paddleocr-vl-1.6" },
      "phase": { "type": "string", "enum": ["requested", "preflighting", "downloading", "verifying", "installing", "self_testing", "succeeded", "failed", "cancelled"] },
      "packRevision": { "type": "integer", "minimum": 1 },
      "operationRevision": { "type": "integer", "minimum": 1 }
    }
  },
  "x-examples": {
    "positive": [{
      "packId": "paddleocr-vl-1.6",
      "expectedRevision": 1,
      "confirmed": true,
      "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
    }],
    "negative": [
      { "packId": "paddleocr-vl-1.6", "expectedRevision": 1, "confirmed": false, "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" },
      { "packId": "paddleocr-vl-1.6", "expectedRevision": 1, "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV" }
    ]
  }
}
