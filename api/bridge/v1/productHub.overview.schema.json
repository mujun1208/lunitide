{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/productHub.overview.schema.json",
  "title": "productHub.overview payload",
  "x-method": "productHub.overview",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "sessionToken": { "type": "string", "minLength": 1, "maxLength": 128 }
  },
  "required": ["sessionToken"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "product": { "type": "string" },
      "editionId": { "type": "string" },
      "generatedAt": { "type": "string" },
      "cardCount": { "type": "integer" },
      "healthScore": { "type": "integer" },
      "added": { "type": "integer" },
      "updated": { "type": "integer" },
      "removed": { "type": "integer" },
      "domains": { "type": "array" },
      "tags": { "type": "array", "items": { "type": "string" } }
    },
    "required": ["product", "editionId", "cardCount", "healthScore"]
  },
  "x-examples": {
    "positive": [{ "sessionToken": "ab" }],
    "negative": [{ "unexpected": true }]
  }
}
