{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/archive.pack.schema.json",
  "title": "archive.pack payload",
  "x-method": "archive.pack",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "destPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "format": {
      "type": "string",
      "enum": ["zip", "tar"]
    },
    "maxEntries": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20000
    },
    "maxBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "required": ["runId", "sources", "destPath", "format", "requestId"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "archivePath": {
        "type": "string"
      },
      "entryCount": {
        "type": "integer",
        "minimum": 0
      },
      "sha256": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      },
      "bytes": {
        "type": "integer",
        "minimum": 0
      }
    },
    "required": ["archivePath", "entryCount", "sha256", "bytes"]
  },
  "x-examples": {
    "positive": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "sources": ["reports/cr-42"],
        "destPath": "packages/cr-42.zip",
        "format": "zip",
        "requestId": "req-3c4d5e"
      }
    ],
    "negative": [
      {
        "runId": "01J8ZG9QV8X2B4C6D8F0G2H4J6",
        "sources": ["reports/cr-42"],
        "destPath": "packages/cr-42.zip",
        "format": "rar",
        "requestId": "req-3c4d5f"
      }
    ]
  }
}
