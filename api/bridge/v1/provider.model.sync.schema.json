      "version": {
        "type": "integer",
        "minimum": 1
      }
    },
    "required": [
      "models",
      "warnings",
      "version"
    ]
  },
  "x-examples": {
    "positive": [
      {
        "providerId": "01ARZ3NDEKTSV4RRFFQ69G5FAV",
