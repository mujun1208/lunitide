{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/provider.model.sync.schema.json",
  "title": "provider.model.sync payload",
  "x-method": "provider.model.sync",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
