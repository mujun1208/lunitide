{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/ocr.pack.notice.list.schema.json",
  "title": "ocr.pack.notice.list payload",
  "x-method": "ocr.pack.notice.list",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["packId"],
  "properties": {
    "packId": { "type": "string", "const": "paddleocr-vl-1.6" },
    "cursor": { "type": "string", "minLength": 1, "maxLength": 512 },
    "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
  },
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["items", "nextCursor"],
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 50,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": ["packId", "manifestDigest", "version", "noticeDigest", "noticeBytes", "verifiedAt", "installedAt", "uninstalledAt"],
          "properties": {
            "packId": { "type": "string", "const": "paddleocr-vl-1.6" },
            "manifestDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "version": { "type": "string", "minLength": 1, "maxLength": 128 },
            "noticeDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            "noticeBytes": { "type": "integer", "minimum": 0 },
            "verifiedAt": { "type": "string", "format": "date-time" },
            "installedAt": { "type": ["string", "null"], "format": "date-time" },
            "uninstalledAt": { "type": ["string", "null"], "format": "date-time" }
          }
        }
      },
      "nextCursor": { "type": ["string", "null"] }
    }
  },
  "x-examples": {
    "positive": [{ "packId": "paddleocr-vl-1.6" }, { "packId": "paddleocr-vl-1.6", "limit": 20 }],
    "negative": [{}, { "packId": "paddleocr-vl-1.6", "limit": 0 }, { "packId": "paddleocr-vl-1.6", "path": "/tmp/NOTICE" }]
  }
}
