    "transcript": { "type": "string", "maxLength": 1048576 }
  },
  "required": ["meetingId"],
  "x-result": {
    "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/MeetingDTO"
