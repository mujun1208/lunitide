  "x-examples": {
    "positive": [
      { "meetingId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "summary": "背景：评审。讨论要点：安装包。结论：下周发布。" },
      { "meetingId": "01ARZ3NDEKTSV4RRFFQ69G5FAV", "actions": "- 导出纪要", "transcript": "大家好" }
    ],
    "negative": [{}, { "summary": "only" }, { "meetingId": "not-a-ulid", "summary": "x" }]
