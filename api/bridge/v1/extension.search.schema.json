{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/extension.search.schema.json",
  "title": "extension.search payload",
  "x-method": "extension.search",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope": {
      "enum": ["personal", "project"]
    },
    "projectId": {
      "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
    },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "publisher": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "maxRisk": {
          "enum": ["low", "medium"]
        }
      },
      "required": []
    }
  },
  "required": ["query", "scope"],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "items": {
        "type": "array",
        "maxItems": 100,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "artifactId": {
              "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID"
            },
            "publisher": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "digest": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "permissions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              }
            },
            "risk": {
              "enum": ["low", "medium", "high"]
            },
            "sbomRef": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          },
          "required": ["artifactId", "publisher", "name", "version", "digest", "permissions", "risk", "sbomRef"]
        }
      }
    },
    "required": ["items"]
  },
  "x-examples": {
    "positive": [
      {
        "query": "pdf tools",
        "scope": "personal"
      },
      {
        "query": "formatter",
        "scope": "project",
        "projectId": "01ARZ3NDEKTSV4RRFFQ69G5FA0",
        "filters": {
          "publisher": "acme",
          "maxRisk": "low"
        }
      }
    ],
    "negative": [
      {
        "query": "",
        "scope": "personal"
      },
      {
        "query": "anything",
        "scope": "global"
      },
      {
        "query": "anything",
        "scope": "project",
        "filters": {
          "maxRisk": "high"
        }
      }
    ]
  }
}
