{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lunitide.local/schema/bridge/v1/memory.purge.prepare.schema.json",
  "title": "memory.purge.prepare payload",
  "x-method": "memory.purge.prepare",
  "x-owner": "engine",
  "x-enabled": true,
  "type": "object",
  "additionalProperties": false,
  "required": ["scopeKind", "expectedDatabaseRevision", "operationId"],
  "properties": {
    "scopeKind": { "type": "string", "enum": ["user", "project"] },
    "scopeId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" },
    "expectedDatabaseRevision": { "type": "integer", "minimum": 0 },
    "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
  },
  "allOf": [
    {
      "if": { "properties": { "scopeKind": { "const": "user" } } },
      "then": { "properties": { "scopeId": false } }
    },
    {
      "if": { "properties": { "scopeKind": { "const": "project" } } },
      "then": { "required": ["scopeId"], "properties": { "scopeId": {} } }
    }
  ],
  "x-result": {
    "type": "object",
    "additionalProperties": false,
    "required": ["counts", "snapshotDigest", "confirmationToken", "expiresAt", "operationId"],
    "properties": {
      "counts": {
        "type": "object",
        "additionalProperties": false,
        "required": ["facts", "candidates", "searchDocuments", "embeddings"],
        "properties": {
          "facts": { "type": "integer", "minimum": 0 },
          "candidates": { "type": "integer", "minimum": 0 },
          "searchDocuments": { "type": "integer", "minimum": 0 },
          "embeddings": { "type": "integer", "minimum": 0 }
        }
      },
      "snapshotDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "confirmationToken": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
      "expiresAt": { "type": "string", "format": "date-time" },
      "operationId": { "$ref": "https://lunitide.local/schema/bridge/v1/public.dto.schema.json#/$defs/ULID" }
    }
  },
  "x-examples": {
    "positive": [
      {
        "scopeKind": "user",
        "expectedDatabaseRevision": 0,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      },
      {
        "scopeKind": "project",
        "scopeId": "01ARZ3NDEKTSV4RRFFQ69G5FAX",
        "expectedDatabaseRevision": 4,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAW"
      }
    ],
    "negative": [
      {
        "scopeKind": "user",
        "scopeId": "01ARZ3NDEKTSV4RRFFQ69G5FAX",
        "expectedDatabaseRevision": 0,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      },
      {
        "scopeKind": "project",
        "expectedDatabaseRevision": 0,
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      },
      {
        "scopeKind": "user",
        "operationId": "01ARZ3NDEKTSV4RRFFQ69G5FAV"
      }
    ]
  }
}
