{
  "name": "@lunitide/renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "generate:bridge": "node scripts/generate-bridge.mjs",
    "verify:bridge": "node scripts/generate-bridge.mjs --check",
    "typecheck": "tsc --noEmit",
    "preview:companion": "vite --open /companion-preview.html",
    "test": "vitest run",
    "test:bounded": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests-bounded.ps1",
    "test:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-test-zombies.ps1",
    "test:stop:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-test-zombies.ps1 -WhatIf",
    "build": "npm run generate:bridge && npm run typecheck && vite build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@vitejs/plugin-react": "^5.0.2",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0",
    "html-to-image": "^1.11.13",
    "mermaid": "^11.12.0",
    "ogl": "^1.0.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
