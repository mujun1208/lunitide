{
  "name": "lunitide",
  "description": "Lunitide 月汐 - local-first AI desktop workspace",
  "author": "Lunitide",
  "license": "UNLICENSED",
  "private": true,
  "comment": "A task runner, not a package. The desktop app is Go plus WebView2; the renderer is a separate package under web/ with its own lockfile. Nothing here has dependencies, so the root needs no install. The shipped version lives in VERSION, which the release workflow checks against the tag.",
  "scripts": {
    "generate:bridge": "npm --prefix web run generate:bridge",
    "verify:bridge": "npm --prefix web run verify:bridge",
    "test:web": "npm --prefix web run test:bounded",
    "test:web:stop": "npm --prefix web run test:stop",
    "setup:engine": "python -m venv .venv && .venv\\Scripts\\python.exe -m pip install --disable-pip-version-check -r engine/requirements-dev.txt",
    "test:engine": ".venv\\Scripts\\python.exe -m pytest engine/tests -q",
    "test:engine:smoke": ".venv\\Scripts\\python.exe engine/tests/smoke_process.py",
    "build:engine": ".venv\\Scripts\\python.exe -m PyInstaller --noconfirm --clean engine/lunitide-engine.spec",
    "release:x64": "powershell -NoProfile -ExecutionPolicy Bypass -File release/Build-Release.ps1",
    "release:x64:stage": "powershell -NoProfile -ExecutionPolicy Bypass -File release/Build-Release.ps1 -SkipInstaller"
  }
}
